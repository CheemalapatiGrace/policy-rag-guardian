# Copy to .env and edit. Everything is optional: the defaults run fully offline.

# --- Providers (default: deterministic local embeddings + extractive MockLLM) ---
RAG_EMBEDDER=hashing            # hashing | ollama
RAG_LLM=mock                    # mock | anthropic | ollama

# Anthropic (only used when RAG_LLM=anthropic). Leave blank in version control!
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (only used when RAG_LLM=ollama or RAG_EMBEDDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Paths ---
RAG_CORPUS_DIR=./data/corpus
RAG_DB_PATH=./.data/guardrail.db
RAG_REGRESSION_PATH=./data/evals/regression.jsonl

# --- Retrieval / guardrail tuning ---
RAG_RETRIEVAL_MODE=hybrid       # hybrid | bm25 | vector
RAG_TOP_K=5
RAG_MIN_EVIDENCE=0.35           # below this top-chunk coverage the system refuses
RAG_REVIEW_CONFIDENCE=0.55      # below this confidence answers are held for human review

# --- Reliability ---
RAG_RATE_LIMIT_PER_MIN=120
RAG_RATE_LIMIT_BURST=30
RAG_MAX_CONCURRENCY=32
RAG_REQUEST_TIMEOUT_S=20

# --- Auth ---
# JSON map of API key -> {"user": ..., "roles": [...]}. When unset, built-in DEMO keys are
# enabled (key-guest, key-employee, key-manager, key-hr, key-security, key-admin, key-reviewer).
# Set RAG_DEMO_KEYS=0 in any real deployment.
RAG_DEMO_KEYS=1
# RAG_API_KEYS={"change-me-1":{"user":"alice","roles":["hr"]}}

# --- Observability ---
# Optional OTLP/HTTP JSON export of every trace (e.g. a local OpenTelemetry collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
RAG_PRICE_IN_PER_MTOK=3.0       # cost estimate only, used for Anthropic/Ollama runs
RAG_PRICE_OUT_PER_MTOK=15.0
